# ---------------------------------------------------------------------------
# StressAlpha Environment Configuration (Template)
# Copy this file to `.env.local` and substitute your actual credentials.
# ---------------------------------------------------------------------------

# Neon Serverless PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: Next.js local server port
PORT=3000

# Better Auth Configuration
# Generate a 32+ character random string (e.g. `openssl rand -hex 32`)
BETTER_AUTH_SECRET="your-32-byte-hex-secret-string"
# Base URL for auth callbacks & session cookies (localhost for dev, production domain for prod)
BETTER_AUTH_URL="http://localhost:3000"

# Neon Ephemeral Database Branching for Isolated Integration Testing (Optional)
# When present, Vitest spins up a 100% copy-on-write replica of production for tests and auto-deletes it upon completion.
# Generate API Key: https://console.neon.tech/app/settings/api-keys
# Find Project ID: Neon Console -> Project Settings -> General
NEON_API_KEY="napi_..."
NEON_PROJECT_ID="your-neon-project-id"

